# Supabase — copy to .env.local and fill real values

# Browser-safe (public)
NEXT_PUBLIC_SUPABASE_URL=https://<project-id>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-publishable-key>

# Server-only (never commit real value)
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-secret-key>

# Postgres (optional — for Drizzle/Prisma/migrations)
DATABASE_URL=postgresql://postgres.<project-id>:<db-password-urlencoded>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.<project-id>:<db-password-urlencoded>@db.<project-id>.supabase.co:5432/postgres
